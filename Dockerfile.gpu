# syntax=docker/dockerfile:1
# Dockerfile.gpu — GPU-accelerated ClipAI build
# Supports: NVIDIA (NVENC/NVDEC/CUDA), Intel (VAAPI/QSV), AMD (VAAPI)

## Stage 1: Build frontend with Node
FROM node:20-slim AS frontend-build
WORKDIR /app/frontend
COPY frontend/package.json frontend/package-lock.json* ./
RUN npm install
COPY frontend/ ./
RUN npm run build

## Stage 1b: Fetch GPU Companion installers (best-effort, never fails)
# Same stage as in the CPU Dockerfile — see backend/routers/downloads.py.
FROM python:3.11-slim AS companion-fetch
ARG COMPANION_VERSION=latest
ARG COMPANION_REPO=jyoung2000/61
WORKDIR /companion
RUN apt-get update && apt-get install -y --no-install-recommends curl ca-certificates \
    && rm -rf /var/lib/apt/lists/*
RUN set +e; \
    if [ "$COMPANION_VERSION" = "latest" ]; then \
      TAG=$(curl -fsSL "https://api.github.com/repos/${COMPANION_REPO}/releases?per_page=30" \
            | python3 -c "import json,sys; rels=[r for r in json.load(sys.stdin) if str(r.get('tag_name','')).startswith('companion-v')]; print(rels[0]['tag_name'] if rels else '')" 2>/dev/null); \
    else \
      TAG="companion-v${COMPANION_VERSION#companion-v}"; \
    fi; \
    if [ -n "$TAG" ]; then \
      echo "Fetching GPU Companion release $TAG"; \
      curl -fsSL "https://api.github.com/repos/${COMPANION_REPO}/releases/tags/${TAG}" \
        | python3 -c "import json,sys; [print(a['browser_download_url']) for a in json.load(sys.stdin).get('assets',[]) if a['name'].lower().endswith(('.exe','.msi','.dmg')) or a['name']=='manifest.json']" 2>/dev/null \
        | while read -r url; do \
            echo "  downloading $url"; \
            curl -fSL --retry 3 -O "$url" || echo "  (skipped: $url)"; \
          done; \
    else \
      echo "No companion-v* release found for ${COMPANION_REPO} — continuing with an empty installer directory"; \
    fi; \
    ls -la /companion || true; \
    exit 0

## Stage 1c: Build the Windows Companion installer from source (OPT-IN)
# Cross-compiles the Tauri app for x86_64-pc-windows-MSVC via cargo-xwin,
# entirely on Linux, then bundles the NSIS .exe. MSVC (not MinGW/GNU) is
# the ONLY Windows toolchain Tauri/WebView2 supports — a GNU build opens
# to a blank white webview and exits, so cargo-xwin is required for a
# working installer. cargo-xwin downloads the MSVC CRT + Windows SDK from
# Microsoft at build time (needs outbound internet; set once).
#
# DEFAULT OFF: the published companion-v* GitHub Release provides the
# COMPLETE installers (Windows .exe/.msi + macOS .dmg, WITH the whisper
# sidecar), which the Settings card serves via redirect and "Fetch from
# GitHub". This stage exists for setups that build locally instead; it
# adds ~20-40 min to the image build and produces a sidecar-less
# Windows-only installer, so it's opt-in:
#   docker compose build --build-arg COMPANION_BUILD_FROM_SOURCE=1
# EVERY step here is fail-soft (set +e / exit 0) so a toolchain hiccup
# can NEVER abort the ClipAI image build — an unrelated concern.
#
# The GTK / libayatana-appindicator3-dev packages look out of place for a
# Windows target, but tauri-cli's bundle-settings step probes the *host*
# for the Linux tray (appindicator) library — a side effect of the
# `tray-icon` feature — and aborts ("Can't detect any appindicator
# library") when it's missing, even though the .exe itself is already
# built. Installing them lets the NSIS bundling step run to completion.
FROM rust:1-bookworm AS companion-builder
ARG COMPANION_BUILD_FROM_SOURCE=0
# The repo's short git SHA (compose passes BUILD_SHA). It becomes the built
# installer's build identity so the Companion's Update button can tell a
# from-source rebuild apart from the running binary even when the semver is
# unchanged — otherwise "up to date" sticks and the new code never installs.
ARG BUILD_SHA=unknown
WORKDIR /build
COPY companion/ ./companion/
ENV XWIN_ACCEPT_LICENSE=1 XWIN_CACHE_DIR=/xwin-cache
# BuildKit cache mounts persist across builds independently of the layer
# cache, so even though `COPY companion/` invalidates this RUN on every code
# change, repeat builds reuse: apt debs, the cargo registry, the compiled
# target dir (incremental — only the changed crate recompiles), the ~1GB MSVC
# SDK (xwin), the cargo-xwin binary, and the npm cache. First build is
# unchanged; subsequent builds drop from ~20-40 min to a few minutes.
RUN --mount=type=cache,target=/var/cache/apt,sharing=locked \
    --mount=type=cache,target=/var/lib/apt,sharing=locked \
    --mount=type=cache,target=/usr/local/cargo/registry \
    --mount=type=cache,target=/usr/local/cargo/git \
    --mount=type=cache,target=/build/companion/src-tauri/target \
    --mount=type=cache,target=/xwin-cache \
    --mount=type=cache,target=/opt/xwin-tools \
    --mount=type=cache,target=/root/.npm \
    set +e; \
    mkdir -p /out; \
    if [ "$COMPANION_BUILD_FROM_SOURCE" != "1" ]; then \
      echo "COMPANION_BUILD_FROM_SOURCE!=1 — skipping from-source installer build (GitHub release is the source)"; \
      exit 0; \
    fi; \
    rm -f /etc/apt/apt.conf.d/docker-clean; \
    export PATH="/opt/xwin-tools/bin:$PATH"; \
    apt-get update && apt-get install -y --no-install-recommends \
      nsis clang llvm lld \
      nodejs npm python3 ca-certificates curl \
      pkg-config libgtk-3-dev libayatana-appindicator3-dev; \
    rustup target add x86_64-pc-windows-msvc; \
    command -v cargo-xwin >/dev/null 2>&1 || CARGO_INSTALL_ROOT=/opt/xwin-tools cargo install cargo-xwin --locked; \
    cd companion; \
    BUNDLE_DIR=src-tauri/target/x86_64-pc-windows-msvc/release/bundle/nsis; \
    rm -f "$BUNDLE_DIR"/*-setup.exe 2>/dev/null || true; \
    export CLIPAI_COMPANION_BUILD_ID="$BUILD_SHA"; \
    npm install --no-audit --no-fund --prefer-offline \
      && npx tauri build --runner cargo-xwin --target x86_64-pc-windows-msvc --bundles nsis; \
    STATUS=$?; \
    EXE=$(ls -t "$BUNDLE_DIR"/*-setup.exe 2>/dev/null | head -1); \
    if [ "$STATUS" = "0" ] && [ -n "$EXE" ]; then \
      cp "$EXE" /out/ \
        && python3 scripts/make_local_manifest.py /out \
        && echo "Companion installer built from source: $(basename "$EXE") [build $BUILD_SHA]"; \
    else \
      echo "Companion from-source build FAILED (status=$STATUS) — image build continues; the Settings card falls back to the GitHub release"; \
    fi; \
    exit 0

## Stage 1d: Companion installer as a standalone export target
# Lets you build JUST the Windows installer straight to a local dir WITHOUT
# rebuilding the whole ClipAI image (the slow Rust/MSVC cross-compile is
# then decoupled from every ClipAI update):
#   DOCKER_BUILDKIT=1 docker build --target companion-artifacts \
#     --build-arg COMPANION_BUILD_FROM_SOURCE=1 -f Dockerfile.gpu \
#     -o ./data/companion-cache .
# ``scratch`` so ONLY the .exe + manifest.json land in the output dir. Not a
# dependency of the runtime stage, so normal builds never build it.
FROM scratch AS companion-artifacts
COPY --from=companion-builder /out/ /

## Stage 2: GPU Runtime
# NVIDIA driver 580+ supports CUDA 13.x. Use CUDA 12.3 runtime which is
# well within the supported range. If CTranslate2 still reports CUDA errors,
# the issue is the NVIDIA Container Toolkit version on the host (Unraid).
FROM nvidia/cuda:12.3.2-cudnn9-runtime-ubuntu22.04

ENV DEBIAN_FRONTEND=noninteractive
# Make pip tolerant of slow/large wheel downloads. The CUDA torch stack pulls
# multi-hundred-MB nvidia-*-cu12 wheels (e.g. nvidia-cudnn-cu12 ~665 MB); the
# 15 s default socket timeout turns a slow CDN read into a hard build failure.
# Applies to every pip call in this image.
ENV PIP_DEFAULT_TIMEOUT=300 \
    PIP_RETRIES=10
ENV NVIDIA_VISIBLE_DEVICES=all
ENV NVIDIA_DRIVER_CAPABILITIES=compute,video,utility
# Ensure CUDA libraries are on the library path for ctranslate2/faster-whisper
ENV LD_LIBRARY_PATH=/usr/local/cuda/lib64:${LD_LIBRARY_PATH}
# Auto-enable GPU acceleration at startup
ENV GPU_ACCELERATION_ENABLED=true
# Force pure-Python protobuf so MediaPipe 0.10.8 graph configs parse correctly
# with protobuf>=4 (required by torch/pyannote). The C++ implementation
# rejects 3.x-format graph definitions under protobuf 4.x.
ENV PROTOCOL_BUFFERS_PYTHON_IMPLEMENTATION=python

# Install system dependencies + VA-API support for Intel/AMD
RUN apt-get update && apt-get install -y \
    python3-pip \
    curl git build-essential pkg-config ca-certificates \
    fontconfig fonts-dejavu-core fonts-freefont-ttf fonts-liberation2 \
    unzip wget software-properties-common \
    # VA-API libraries for Intel/AMD GPU support
    libva-dev libva-drm2 libva-x11-2 vainfo \
    libdrm-dev mesa-va-drivers \
    # FFmpeg build dependencies
    nasm yasm \
    libass-dev libfreetype6-dev libfontconfig1-dev libfribidi-dev \
    libmp3lame-dev libopus-dev libvorbis-dev libx264-dev libx265-dev \
    libnuma-dev libvpx-dev libfdk-aac-dev \
    # MediaPipe face detection dependencies
    libgl1-mesa-glx libglib2.0-0 \
    && rm -rf /var/lib/apt/lists/*

# Install nv-codec-headers for NVENC/NVDEC support.
# Pinned release tarball from the official GitHub mirror with retries —
# git.videolan.org regularly aborts clones mid-fetch (curl 92 HTTP/2
# INTERNAL_ERROR / "early EOF"), which killed whole image builds. The
# videolan git remains as a shallow-clone fallback only. n12.1.14.0
# matches the CUDA 12.1 runtime this image uses (needs driver >= 530,
# which any box running torch cu121 already has).
RUN set -e; cd /tmp; \
    ( curl --retry 5 --retry-delay 5 --retry-all-errors -fsSL \
        -o nv-codec-headers.tar.gz \
        https://github.com/FFmpeg/nv-codec-headers/archive/refs/tags/n12.1.14.0.tar.gz \
      && tar xf nv-codec-headers.tar.gz ) \
    || git clone --depth 1 --branch n12.1.14.0 \
        https://git.videolan.org/git/ffmpeg/nv-codec-headers.git \
        nv-codec-headers-n12.1.14.0 \
    || git clone --depth 1 \
        https://github.com/FFmpeg/nv-codec-headers.git \
        nv-codec-headers-n12.1.14.0; \
    make -C nv-codec-headers-n12.1.14.0 install; \
    cd /; rm -rf /tmp/nv-codec-headers*

# Build FFmpeg with full hardware acceleration
RUN cd /tmp && \
    wget -q --tries=5 --waitretry=5 https://ffmpeg.org/releases/ffmpeg-7.1.tar.xz && \
    tar xf ffmpeg-7.1.tar.xz && \
    cd ffmpeg-7.1 && \
    ./configure \
        --prefix=/usr/local \
        --enable-gpl \
        --enable-nonfree \
        --enable-libass \
        --enable-libfreetype \
        --enable-libfontconfig \
        --enable-libfribidi \
        --enable-libmp3lame \
        --enable-libopus \
        --enable-libvorbis \
        --enable-libvpx \
        --enable-libx264 \
        --enable-libx265 \
        --enable-libfdk-aac \
        --enable-cuda \
        --enable-cuvid \
        --enable-nvenc \
        --enable-nvdec \
        --enable-vaapi \
    && make -j$(nproc) && make install && \
    ldconfig && \
    cd / && rm -rf /tmp/ffmpeg*

# Install DM Sans font (default subtitle font)
RUN mkdir -p /usr/share/fonts/truetype/dmsans && \
    curl --retry 4 --retry-delay 5 --retry-all-errors -fsSL -o /usr/share/fonts/truetype/dmsans/DMSans.ttf \
      "https://github.com/google/fonts/raw/main/ofl/dmsans/DMSans%5Bopsz%2Cwght%5D.ttf" && \
    curl --retry 4 --retry-delay 5 --retry-all-errors -fsSL -o /usr/share/fonts/truetype/dmsans/DMSans-Italic.ttf \
      "https://github.com/google/fonts/raw/main/ofl/dmsans/DMSans-Italic%5Bopsz%2Cwght%5D.ttf" && \
    fc-cache -f -v

# Install popular Google Fonts for subtitle use
# Use --retry with backoff to handle GitHub rate limiting (429)
RUN mkdir -p /usr/share/fonts/truetype/google-fonts && \
    cd /usr/share/fonts/truetype/google-fonts && \
    curl --retry 4 --retry-delay 5 --retry-all-errors -fsSL -o Montserrat.ttf "https://github.com/google/fonts/raw/main/ofl/montserrat/Montserrat%5Bwght%5D.ttf" && \
    curl --retry 4 --retry-delay 5 --retry-all-errors -fsSL -o OpenSans.ttf "https://github.com/google/fonts/raw/main/ofl/opensans/OpenSans%5Bwdth%2Cwght%5D.ttf" && \
    curl --retry 4 --retry-delay 5 --retry-all-errors -fsSL -o Roboto.ttf "https://github.com/google/fonts/raw/main/ofl/roboto/Roboto%5Bwdth%2Cwght%5D.ttf" && \
    curl --retry 4 --retry-delay 5 --retry-all-errors -fsSL -o Poppins-Regular.ttf "https://github.com/google/fonts/raw/main/ofl/poppins/Poppins-Regular.ttf" && \
    curl --retry 4 --retry-delay 5 --retry-all-errors -fsSL -o Poppins-Bold.ttf "https://github.com/google/fonts/raw/main/ofl/poppins/Poppins-Bold.ttf" && \
    curl --retry 4 --retry-delay 5 --retry-all-errors -fsSL -o Inter.ttf "https://github.com/google/fonts/raw/main/ofl/inter/Inter%5Bopsz%2Cwght%5D.ttf" && \
    curl --retry 4 --retry-delay 5 --retry-all-errors -fsSL -o Nunito.ttf "https://github.com/google/fonts/raw/main/ofl/nunito/Nunito%5Bwght%5D.ttf" && \
    curl --retry 4 --retry-delay 5 --retry-all-errors -fsSL -o Lato-Regular.ttf "https://github.com/google/fonts/raw/main/ofl/lato/Lato-Regular.ttf" && \
    curl --retry 4 --retry-delay 5 --retry-all-errors -fsSL -o Lato-Bold.ttf "https://github.com/google/fonts/raw/main/ofl/lato/Lato-Bold.ttf" && \
    curl --retry 4 --retry-delay 5 --retry-all-errors -fsSL -o Oswald.ttf "https://github.com/google/fonts/raw/main/ofl/oswald/Oswald%5Bwght%5D.ttf" && \
    curl --retry 4 --retry-delay 5 --retry-all-errors -fsSL -o PlayfairDisplay.ttf "https://github.com/google/fonts/raw/main/ofl/playfairdisplay/PlayfairDisplay%5Bwght%5D.ttf" && \
    curl --retry 4 --retry-delay 5 --retry-all-errors -fsSL -o BebasNeue-Regular.ttf "https://github.com/google/fonts/raw/main/ofl/bebasneue/BebasNeue-Regular.ttf" && \
    fc-cache -f -v

# Register /data/fonts with fontconfig so libass picks up custom fonts
RUN mkdir -p /data/fonts && \
    echo '<?xml version="1.0"?>\n<!DOCTYPE fontconfig SYSTEM "fonts.dtd">\n<fontconfig><dir>/data/fonts</dir></fontconfig>' \
    > /etc/fonts/conf.d/99-custom-fonts.conf

WORKDIR /app

# Install Python dependencies (including CUDA-enabled faster-whisper)
COPY backend/requirements.txt .

# Install the CUDA build of torch FIRST, in its OWN layer, so a failure here is
# isolated + obvious and the rest of the image still builds. Without the CUDA
# wheel the GPU image silently shipped CPU-only torch
# (torch.cuda.is_available()==False), forcing YOLO-World + face/embedding work
# onto the CPU — the ~10-30x-slower analysis. EXACT-pin torch+torchaudio to
# the versions also pinned in requirements.txt (==2.5.1), from the cu121 index
# (matches the CUDA 12.x runtime base + GTX 1650 / sm_75). The exact pin is
# critical: a range let `-r requirements.txt` (via pyannote) UPGRADE torch to
# 2.12, uninstall this CUDA wheel, and pull ~2 GB of cu13 packages until the
# disk filled. If the cu121 index is unreachable the ``||`` falls back so the
# build STILL COMPLETES; the runtime then emits the visible "running on CPU"
# warning instead of bricking the image.
# Hardened against transient failures on the large (~2 GB) CUDA download:
#  - a BuildKit pip cache mount so each retry / rebuild reuses wheels that
#    already downloaded and only re-fetches what's missing (image size is
#    unaffected — the cache lives in the build cache, not a layer);
#  - a 3x retry-with-backoff loop so a dropped read doesn't fail the build.
# pip itself also retries (PIP_RETRIES) with a long socket timeout
# (PIP_DEFAULT_TIMEOUT). cu121 index first; PyPI as a fallback.
RUN --mount=type=cache,target=/root/.cache/pip,sharing=locked \
    pip3 install --upgrade pip && \
    for attempt in 1 2 3; do \
        echo "==> torch/CUDA install attempt $attempt/3"; \
        ( pip3 install torch==2.5.1 torchaudio==2.5.1 \
            --index-url https://download.pytorch.org/whl/cu121 \
          || pip3 install torch==2.5.1 torchaudio==2.5.1 ) && break; \
        echo "==> attempt $attempt failed; retrying in $((attempt * 15))s"; sleep $((attempt * 15)); \
    done && \
    python3 -c 'import torch; print("torch", torch.__version__, "CUDA-build:", torch.version.cuda or "NONE (CPU-only)")'

# requirements.txt pins torch==2.5.1 / torchaudio==2.5.1 (and pyannote<4), so
# the CUDA torch installed above is treated as already-satisfied and pip does
# NOT swap it for a CPU wheel. pyannote 3.x gets its full dependency tree here
# in the normal requirements install.
RUN --mount=type=cache,target=/root/.cache/pip,sharing=locked \
    pip3 install -r requirements.txt && \
    pip3 install nvidia-cublas-cu12 nvidia-cudnn-cu12==9.* && \
    # FAIL the build if the requirements install swapped torch off the pinned
    # cu121 wheel (e.g. a dep loosened its constraint and pip upgraded torch to
    # a giant cu13 build — the exact failure that filled the disk). Catching it
    # here aborts in seconds instead of after a 2 GB download.
    python3 -c 'import torch,sys; cu=torch.version.cuda; print("post-reqs torch",torch.__version__,"CUDA-build:",cu or "NONE (CPU-only)"); sys.exit(0 if (cu and cu.startswith("12")) else 1)' && \
    # MediaPipe runtime deps (installed separately to avoid protobuf conflict)
    pip3 install \
        flatbuffers>=23.1.4 \
        attrs>=23.1.0 \
        sounddevice>=0.4.6 \
        absl-py>=1.0.0 && \
    # MediaPipe itself — skip deps to avoid protobuf<4 constraint
    pip3 install --no-deps mediapipe==0.10.8 && \
    # Verify MediaPipe can actually load (fail build early if broken)
    python3 -c "import mediapipe; print(f'MediaPipe {mediapipe.__version__} installed')" && \
    python3 -c "import mediapipe.python.solutions.face_mesh; print('FaceMesh available')" && \
    # Register pip-installed NVIDIA libs so ctranslate2/torch can find them at runtime
    python3 -c "import nvidia.cublas; print(nvidia.cublas.__path__[0] + '/lib')" >> /etc/ld.so.conf.d/nvidia-pip.conf && \
    python3 -c "import nvidia.cudnn; print(nvidia.cudnn.__path__[0] + '/lib')" >> /etc/ld.so.conf.d/nvidia-pip.conf && \
    ldconfig


# ── CLIP text encoder for YOLO-World open-vocabulary detection ──────────
# ultralytics' set_classes() needs the `clip` package to encode class
# prompts ("person, head, face, character, mecha…"). Without it the run
# logs "set_classes failed: No module named 'clip'" and subject detection
# silently degrades to generic COCO classes — observed on the 2026-07-03
# runs. Install from a pinned tarball (no git needed), --no-deps so the
# torch/torchvision pins stay untouched (ftfy/regex are CLIP's only
# missing deps), then pre-bake the ViT-B/32 weights (~340MB) so the first
# analysis doesn't stall on a download.
RUN pip3 install --no-cache-dir ftfy regex && \
    pip3 install --no-cache-dir --no-deps \
        "clip @ https://github.com/ultralytics/CLIP/archive/refs/heads/main.tar.gz" && \
    python3 -c "import clip; clip.load('ViT-B/32', device='cpu'); print('CLIP ViT-B/32 baked')"

# ── Single-OpenCV guarantee ──────────────────────────────────────────────
# ultralytics declares `opencv-python` (the GUI build) as a dependency, so
# the requirements install can end up with BOTH opencv-python and
# opencv-python-headless sharing one cv2/ directory. That mixed install is
# how a runtime ends up with `module 'cv2' has no attribute
# 'CascadeClassifier'` while other cv2 symbols still resolve. Purge every
# opencv distribution and force-reinstall the single pinned headless build
# LAST so its files are authoritative, then fail the build if core symbols
# are missing.
RUN pip3 uninstall -y opencv-python opencv-contrib-python opencv-python-headless opencv-contrib-python-headless || true && \
    pip3 install --no-cache-dir --force-reinstall --no-deps opencv-python-headless==4.10.0.84 && \
    python3 -c "import cv2; assert hasattr(cv2, 'CascadeClassifier') and hasattr(cv2, 'FaceDetectorYN'), 'broken cv2'; print('cv2', cv2.__version__, 'OK (CascadeClassifier + FaceDetectorYN present)')"

# ultralytics must NEVER pip-install packages at runtime (it would overwrite
# the pinned OpenCV mid-process on the first YOLO import).
ENV YOLO_AUTOINSTALL=false

# Download YuNet model for face detection fallback (~350KB, one-time)
# Download SFace recognition model for identity embeddings (~2MB, one-time)
# Download lbpcascade_animeface for v2 Phase 6 anime face detection (~110KB)
RUN mkdir -p /app/backend/models && \
    curl --retry 4 --retry-delay 5 --retry-all-errors -fsSL \
    -o /app/backend/models/face_detection_yunet_2023mar.onnx \
    "https://github.com/opencv/opencv_zoo/raw/main/models/face_detection_yunet/face_detection_yunet_2023mar.onnx" && \
    curl --retry 4 --retry-delay 5 --retry-all-errors -fsSL \
    -o /app/backend/models/face_recognition_sface_2021dec.onnx \
    "https://github.com/opencv/opencv_zoo/raw/main/models/face_recognition_sface/face_recognition_sface_2021dec.onnx" && \
    curl --retry 4 --retry-delay 5 --retry-all-errors -fsSL \
    -o /app/backend/models/lbpcascade_animeface.xml \
    "https://github.com/nagadomi/lbpcascade_animeface/raw/master/lbpcascade_animeface.xml" && \
    curl --retry 4 --retry-delay 5 --retry-all-errors -fsSL \
    -o /app/backend/models/u2netp.onnx \
    "https://github.com/danielgatis/rembg/releases/download/v0.0.0/u2netp.onnx"

# v4.1: pre-download YOLOv8n weights for PersonDetector / ObjectDetector
# (~5.5MB). object_detector.py looks at /data/models/yolov8n.pt first,
# so stash the weights there at build time. Without this step the first
# analysis run would stall for 10-30s while ultralytics downloads the
# model from GitHub — or fail silently if the container has no internet.
# Also verify the model can actually load so a broken build fails early.
RUN mkdir -p /data/models && \
    curl --retry 4 --retry-delay 5 --retry-all-errors -fsSL \
      -o /data/models/yolov8n.pt \
      "https://github.com/ultralytics/assets/releases/download/v8.2.0/yolov8n.pt" && \
    python3 -c "from ultralytics import YOLO; m = YOLO('/data/models/yolov8n.pt'); print(f'YOLOv8n loaded: {len(m.names)} classes')"

# Reframer engine: YOLO-World v2 open-vocabulary detector (~25MB). The
# reframer's FaceDetector uses it for per-video subject auto-discovery and
# loads it from backend/models/. Pre-fetch at build time so the first
# analysis run doesn't stall on an ultralytics download.
RUN mkdir -p /app/backend/models && \
    curl --retry 4 --retry-delay 5 --retry-all-errors -fsSL \
      -o /app/backend/models/yolov8s-worldv2.pt \
      "https://github.com/ultralytics/assets/releases/download/v8.2.0/yolov8s-worldv2.pt" && \
    python3 -c "from ultralytics import YOLO; m = YOLO('/app/backend/models/yolov8s-worldv2.pt'); print(f'YOLO-World v2 loaded: {len(m.names)} classes')"

# Pre-download the Demucs htdemucs model (~80 MB) for vocal separation so the
# first job with VOCAL_SEPARATION_ENABLED doesn't stall on a download — and so
# it works on hosts with no outbound internet. Cached in the torch-hub dir
# (same root user at build + runtime, so it persists into the image). The
# "|| echo WARN" keeps the build green if the CDN is unreachable; the runtime
# loader self-heals to the full audio if the model still can't be fetched.
RUN python3 -c "from demucs.pretrained import get_model; get_model('htdemucs'); print('htdemucs cached')" \
    || echo "WARN: htdemucs pre-download failed — will download at runtime"

# ── Optional: VideoLLaMA2 — local audio-visual Primary AI ──
# VideoLLaMA2.1-7B-AV gives offline clip discovery that hears the video
# (laughter, applause, music). It needs ~10GB VRAM (RTX 4070+) and pulls
# heavy, version-sensitive deps, so it is OPT-IN and OFF by default — the
# engine falls back to Ollama, then cloud, then signal-only without it.
# Enable with:  docker build --build-arg ENABLE_VIDEOLLAMA2=1 ...
# The repo is vendored at backend/services/VideoLLaMA2/, which the clipper
# adds to sys.path; weights download from HuggingFace on first analysis.
ARG ENABLE_VIDEOLLAMA2=0
RUN if [ "$ENABLE_VIDEOLLAMA2" = "1" ]; then \
      set -e; \
      git clone --depth 1 https://github.com/DAMO-NLP-SG/VideoLLaMA2 \
        /app/backend/services/VideoLLaMA2 && \
      pip3 install --no-cache-dir \
        accelerate bitsandbytes einops decord timm sentencepiece && \
      python3 -c "import sys; sys.path.insert(0,'/app/backend/services/VideoLLaMA2'); \
import importlib.util; \
print('videollama2 import OK' if importlib.util.find_spec('videollama2') \
else 'WARN: videollama2 still not importable')"; \
    else echo "VideoLLaMA2 disabled (ENABLE_VIDEOLLAMA2=0) — using Ollama/cloud fallback"; \
    fi

# Pre-download InsightFace buffalo_s ArcFace pack so the first run with
# CLIPAI_FACE_EMBEDDING=arcface doesn't stall. CPU-only via onnxruntime —
# never touches the GPU. The "|| echo" keeps the build green if the CDN
# is unreachable; the lazy loader will retry at runtime.
RUN mkdir -p /app/backend/models/insightface && \
    python3 -c "from insightface.app import FaceAnalysis; \
                FaceAnalysis(name='buffalo_s', root='/app/backend/models/insightface', \
                             providers=['CPUExecutionProvider']).prepare(ctx_id=-1, det_size=(320,320))" \
    || echo "WARN: buffalo_s pre-download failed — will download at runtime"

# ── GPU onnxruntime for u2netp saliency ─────────────────────────────────
# Swap the CPU wheel (pulled by requirements.txt) for onnxruntime-gpu so the
# u2netp salient-object model runs on CUDA during the face loop — the
# profiled anime run spent most of its per-sample overhead on these CPU
# forwards (~0.4-0.5 s each; ~5-15 ms on the GPU). The GPU wheel bundles the
# CPU EP too, so CPU-pinned callers (insightface/ArcFace above) behave
# exactly as before. 1.19.x is the CUDA 12 / cuDNN 9 build matching this
# base image. Fail-soft: if the GPU wheel can't install, restore the CPU
# wheel so the build never breaks (u2netp then runs on CPU as before).
RUN pip3 uninstall -y onnxruntime onnxruntime-gpu || true && \
    (pip3 install --no-cache-dir "onnxruntime-gpu==1.19.2" || \
     pip3 install --no-cache-dir "onnxruntime>=1.17.0")

# Copy backend source
COPY backend/ ./backend/
# The SEO intelligence layer ships data files (banned tags, evergreen
# trends, platform rules). A build without them silently degrades to
# built-in fallbacks at runtime — fail the BUILD instead so a filtered
# copy or broken context is caught here, not in production logs.
RUN test -f backend/data/banned_tags.json \
    && test -f backend/data/evergreen_trends.json \
    && test -f backend/data/platform_rules.json

# Bake build identity so the running container logs which commit it was built
# from (the repo's .git isn't copied → git rev-parse returns "unknown").
ARG BUILD_SHA=unknown
ARG BUILD_SUBJECT=""
RUN printf '%s\n%s\n' "$BUILD_SHA" "$BUILD_SUBJECT" > /app/BUILD_INFO

# Copy the markdown docs so the cloud storage setup guide (and friends)
# can be rendered at /docs/cloud-storage/SETUP.md by backend/main.py.
COPY docs/ ./docs/

# Copy pre-built frontend from stage 1
COPY --from=frontend-build /app/frontend/dist ./static

# GPU Companion installers: the from-source Windows build (stage 1c)
# first, then the GitHub release assets (stage 1b) OVER it — same-named
# files (manifest.json) from a published release win, so the from-source
# fallback only surfaces when no companion-v* release exists yet.
COPY --from=companion-builder /out/ ./static/companion/
COPY --from=companion-fetch /companion/ ./static/companion/

EXPOSE 1353

CMD ["python3", "-m", "uvicorn", "backend.main:app", "--host", "0.0.0.0", "--port", "1353", "--workers", "1"]
