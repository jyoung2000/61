__pycache__/
node_modules/
frontend/dist/
data/
# Local settings file auto-created by backend/config.py when running outside
# Docker (tests, local CLI). Can carry user API keys — never commit it.
.env
# Local persisted user settings dir (written by the settings router /
# pipeline when running outside the Docker data mount, e.g. tests).
.clipai/
# Downloaded model weights (YuNet face detector, YOLO-World, etc.)
backend/models/*.onnx
backend/models/*.pt

# Week 3 real-content clip cache + extraction cache. The manifest
# at tests/real_content/manifest.json pins sha256 hashes; clips are
# pulled via tests/real_content/fetch.sh into
# $CLIPAI_REAL_CONTENT_CACHE (default /var/cache/clipai/real_content).
tests/real_content/*.mp4
tests/real_content/*.mov
tests/real_content/*.mkv
tests/real_content/*.webm
tests/real_content/extraction_cache/
tests/real_content/ground_truth/

# Vendored VideoLLaMA2 source (cloned at Docker build with ENABLE_VIDEOLLAMA2=1)
backend/services/VideoLLaMA2/

# Per-session reframer log files written by ReframeLogger when code
# runs outside Docker (tests, local CLI). In Docker the logger
# propagates to /data/logs/app.log instead so these don't accumulate.
backend/services/logs/

# ── GPU Companion (companion/) build artifacts ──
# No binaries in git: installers live in GitHub Releases + Docker layers.
companion/src-tauri/target/
companion/src-tauri/gen/
companion/src-tauri/sidecar/*
!companion/src-tauri/sidecar/README.md
companion/dist/
companion/whisper.cpp/
companion/sidecars/whisper-server/build/
companion/sidecars/whisper-server/dist/
# Installers baked into the ClipAI image at Docker build time.
static/companion/
