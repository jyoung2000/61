# ClipAI — example environment file.
# Copy this to ``.env`` (or wire these into your Unraid container template)
# and fill in the values you need. Every variable is OPTIONAL except the
# cloud-storage encryption key when CLIPAI_CLOUD_STORAGE_ENABLED is on.

# ── AI providers ─────────────────────────────────────────────────────────
OPENROUTER_API_KEY=
ANTHROPIC_API_KEY=
GEMINI_API_KEY=
GROQ_API_KEY=
HF_AUTH_TOKEN=
REPLICATE_API_KEY=

# ── Local (Ollama) models for Offline Mode ───────────────────────────────
# OLLAMA_HOST=http://127.0.0.1:11434
# Editorial model (SEO + summaries) — keep at the 3B class so it stays GPU-
# resident on a 4 GB card:
# OLLAMA_EDITORIAL_MODEL=qwen2.5:3b-instruct
# Subtitle TRANSLATION + polish model. Default qwen3:4b-instruct-2507; a
# qwen3.5:4b build is auto-preferred when installed (same ~2.5 GB Q4 footprint,
# fits the partial-offload ladder). For an UNATTENDED BATCH quality run only,
# you may point this at an 8B-Q4 (~5 GB): on a 4 GB GTX 1650 the gpu_offload
# ladder steps it down (many layers to CPU) so it won't OOM, but throughput
# drops a LOT — keep the 4B as the resident default; do not make 8B default on
# this card. Nothing here calls a cloud API.
# OLLAMA_TRANSLATION_MODEL=qwen3:4b-instruct-2507-q4_K_M

# ── GPU selection ───────────────────────────────────────────────────────
# Pin ClipAI (and its Ollama sidecar) to ONE GPU on a multi-GPU host.
# Run `nvidia-smi -L` to list cards, then set this to that card's index
# (0, 1, ...) or — more stable across reboots — its GPU-<uuid> string.
# Example for a box with a 4070 + a 1650, to use only the 1650:
#   CLIPAI_GPU_ID=GPU-xxxxxxxx-xxxx-xxxx-xxxx-xxxxxxxxxxxx
# Leave blank to use GPU 0.
CLIPAI_GPU_ID=

# Device for the reframer's YOLO-World subject pass: auto | cuda | cpu.
# 'auto' uses the GPU when >=3.5GB VRAM is free (covers a 4GB GTX 1650).
CLIPAI_REFRAMER_YOLO_DEVICE=auto

# ── API key for /api/v1/* ───────────────────────────────────────────────
# Leave blank to have ClipAI auto-generate + persist one on first boot.
CLIPAI_API_KEY=

# ── Cloud storage integration (Google Drive + Box) ──────────────────────
# Feature flag. Set to "false" to kill the entire integration from the
# Unraid template if something goes wrong in production.
CLIPAI_CLOUD_STORAGE_ENABLED=true

# 32 url-safe base64-encoded bytes used to encrypt OAuth tokens at rest.
# Generate one with:
#   python -c "from cryptography.fernet import Fernet; print(Fernet.generate_key().decode())"
# If you leave this blank, an ephemeral key is generated at startup and
# every container restart drops your stored cloud sessions.
CLIPAI_TOKEN_ENC_KEY=

# Google Drive OAuth app (from console.cloud.google.com → APIs & Services).
# Scope used: https://www.googleapis.com/auth/drive.readonly
# See docs/cloud-storage/SETUP.md for the full walkthrough.
GOOGLE_DRIVE_CLIENT_ID=
GOOGLE_DRIVE_CLIENT_SECRET=
GOOGLE_DRIVE_REDIRECT_URI=http://localhost:8000/api/cloud/google_drive/callback

# Box OAuth app (from app.box.com/developers/console).
# Enable "Read all files and folders stored in Box" in the app's
# configuration; leave every write permission off.
BOX_CLIENT_ID=
BOX_CLIENT_SECRET=
BOX_REDIRECT_URI=http://localhost:8000/api/cloud/box/callback

# ── Reframer "human camera operator" upgrades ──────────────────────────
# Each flag toggles one reframing improvement. Pure-code items default ON;
# model-dependent / invasive items default OFF (they need an extra model or
# fall back gracefully). Leave unset to use the defaults in backend/config.py.
#
# Smoothing / motion model (default ON):
#   REFRAMER_ONE_EURO_FILTER=true       # speed-adaptive target smoothing (vs EMA)
#   REFRAMER_SAVGOL_SMOOTHING=true       # offline Savitzky-Golay path pass
#   REFRAMER_SALIENCY_STACK=true         # fused saliency + temporal smoothing (no-face)
#   REFRAMER_LEAD_ROOM=true              # anticipatory lead-room (velocity + gaze)
#   REFRAMER_EYE_LINE_ANCHOR=true        # frame on the eye-line, not the bbox center
#   REFRAMER_OVERLAY_VELOCITY=true       # emit per-box velocity for preview propagation
#
# Model-dependent (default OFF — needs an extra model download):
#   REFRAMER_MEDIAPIPE_MAR=false         # MediaPipe 478-pt lips MAR (needs face_landmarker.task)
#   REFRAMER_MEDIAPIPE_MODEL_PATH=       # path to face_landmarker.task (blank = auto-discover)
#
# Higher-ceiling items (default ON):
#   REFRAMER_U2NET_SALIENCY=true         # u2netp learned saliency; the model is baked into the
#                                        #   image and auto-discovered (spectral fallback if missing)
#   REFRAMER_U2NET_MODEL_PATH=           # explicit path override (blank = auto-discover)
#   REFRAMER_L1_PATH=true                # L1-optimal camera path (holds + linear pans)
#   REFRAMER_L1_WEIGHTS=1,10,100         # w1,w2,w3 for |D1|,|D2|,|D3|
#   REFRAMER_MOTIVATED_ZOOM=true         # slow push-in on held speakers (no-op without a real hold)
#   REFRAMER_MOTIVATED_ZOOM_MAX=1.15     # max push-in scale
#
# Human-operator framing (audit Phase 2, default ON):
#   REFRAMER_L1_DEADBAND_FRAC=0.025      # subject motion under 2.5% of crop width doesn't move the camera
#   REFRAMER_SACCADE_CUT_FRAC=0.38       # displacements over 38% of crop width cut instead of whip-panning
#   REFRAMER_VERTICAL_EYELINE=true       # eye-line at 1/3 from crop top for 16:9/4:3 outputs (vs blind centering)
#   REFRAMER_HEADROOM_MIN_FRAC=0.08      # min face-to-crop-edge margin (fraction of crop height)
#   REFRAMER_EXPORT_KEYPOINT_HZ=10       # min keypoint density for the FFmpeg motion path (kills velocity steps)
#   REFRAMER_TILED_ADAPTIVE=true         # run tiled face detection only when faces are small/missing (faster)
#   REFRAMER_TILED_MIN_FACE_FRAC=0.04    # "small face" threshold — fraction of frame height

# ── Transcription quality (audit Phase 3) ───────────────────────────────
# CTC forced-alignment refinement of Whisper word timestamps (torchaudio
# wav2vec2 or the ctc-forced-aligner package; <1 GB, GPU only when free).
# Cues snap within ~1 frame of speech onset/offset. No-op without a backend.
#   SUBTITLE_FORCED_ALIGN=true
# VAD tuning + faster-whisper's silence-gap hallucination guard:
#   WHISPER_VAD_MIN_SILENCE_MS=300
#   WHISPER_VAD_SPEECH_PAD_MS=150
#   WHISPER_HALLUCINATION_SILENCE_S=2.0
# Two-pass redecode of difficult segments (hallucination-flagged, low
# avg_logprob, or degenerate batched word timing), bounded to 10%:
#   WHISPER_REDECODE_ENABLED=true
#   WHISPER_REDECODE_LOGPROB=-0.8
#   WHISPER_REDECODE_MAX_FRAC=0.10
#   WHISPER_REDECODE_BEAM=8
# Auto-upgrade targets distil-large-v3 instead of large-v3-turbo on
# English-only libraries (distil ≈ large-v3 English WER at ~2x speed):
#   WHISPER_PREFER_DISTIL_ENGLISH=false

# ── Cloud transcription + subtitle polish model (audit Phase 4) ─────────
# Where the primary transcription pass runs. Cloud output flows through
# the SAME post chain (hallucination filter → forced alignment → polish →
# formatter) and falls back to local automatically on API failure.
#   TRANSCRIPTION_PROVIDER=local            # local | groq | openai
#   GROQ_TRANSCRIBE_MODEL=whisper-large-v3-turbo
#   OPENAI_TRANSCRIBE_MODEL=whisper-1       # or gpt-4o-transcribe (words re-timed by forced alignment)
#   OPENAI_API_KEY=
# Dedicated subtitle-polish model (an OpenRouter id — see Settings >
# Subtitle Quality > "Recommended for subtitle polish"). Blank = polish
# runs on the translation model (legacy default).
#   SUBTITLE_POLISH_MODEL=

# ── Container speed (audit Phase 5) ─────────────────────────────────────
# Perception decode: grab() sequentially for gaps up to this many frames;
# only larger jumps hard-seek (each seek re-decodes a whole GOP on
# long-GOP H.264 — the old gap>5 threshold seeked on EVERY sample).
# Benchmark strategies on your content: scripts/bench_perception_decode.py
#   REFRAMER_SEEK_GAP_FRAMES=60
# NVENC speed/quality toggle: p1 (fastest) .. p7 (best quality).
# Adaptive quantization (-spatial_aq/-temporal_aq) is always on for NVENC.
#   GPU_NVENC_PRESET=p5
# Run Demucs vocal separation concurrent with the visual perception pass.
# Auto-degrades to sequential on GPUs under 6 GB total (a 4 GB GTX 1650
# never runs Demucs + YOLO at the same time).
#   VOCAL_SEPARATION_CONCURRENT=true
