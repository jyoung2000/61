# ClipAI — example environment file.
# Copy this to ``.env`` (or wire these into your Unraid container template)
# and fill in the values you need. Every variable is OPTIONAL except the
# cloud-storage encryption key when CLIPAI_CLOUD_STORAGE_ENABLED is on.

# ── AI providers ─────────────────────────────────────────────────────────
OPENROUTER_API_KEY=
ANTHROPIC_API_KEY=
GEMINI_API_KEY=
GROQ_API_KEY=
HF_AUTH_TOKEN=
REPLICATE_API_KEY=

# ── Local (Ollama) models for Offline Mode ───────────────────────────────
# OLLAMA_HOST=http://127.0.0.1:11434
# Editorial model (SEO + summaries) — keep at the 3B class so it stays GPU-
# resident on a 4 GB card:
# OLLAMA_EDITORIAL_MODEL=qwen2.5:3b-instruct
# Subtitle TRANSLATION + polish model. Default qwen3:4b-instruct-2507; a
# qwen3.5:4b build is auto-preferred when installed (same ~2.5 GB Q4 footprint,
# fits the partial-offload ladder). For an UNATTENDED BATCH quality run only,
# you may point this at an 8B-Q4 (~5 GB): on a 4 GB GTX 1650 the gpu_offload
# ladder steps it down (many layers to CPU) so it won't OOM, but throughput
# drops a LOT — keep the 4B as the resident default; do not make 8B default on
# this card. Nothing here calls a cloud API.
# OLLAMA_TRANSLATION_MODEL=qwen3:4b-instruct-2507-q4_K_M

# Extra seconds granted on top of a text call's timeout when the target
# Ollama model is NOT yet loaded (cold start). On a 4 GB card a cold load
# (unload other model + read ~2 GB weights from disk) routinely takes
# 60-150s — without this allowance it trips the 90s polish timeout and
# pushes batches to the paid cloud fallback. Warm calls keep the tight
# timeout. 0 disables.
# OLLAMA_COLD_LOAD_TIMEOUT_EXTRA_S=240

# ── Remote GPU sharing (see docs/remote-gpu.md) ─────────────────────────
# Multi-host Ollama registry. JSON array; ARRAY ORDER IS PRIORITY — index 0
# is the primary, the rest are ordered fallbacks with automatic failover.
# Usually managed from Settings → AI Providers → Ollama Hosts (drag to
# reorder) or auto-filled by pairing a GPU Companion; set here only for
# env-only deployments. Host URLs may include a base path (the Companion
# proxy exposes Ollama at http://<desktop>:11500/ollama) and an optional
# per-host bearer token. Blank = single-host behavior via OLLAMA_HOST.
# OLLAMA_HOSTS=[{"id":"desktop","name":"Desktop 4070","url":"http://192.168.1.50:11500/ollama","token":"...","enabled":true},{"id":"sidecar","name":"Unraid sidecar","url":"http://ollama:11434","token":"","enabled":true}]

# Remote Whisper — any OpenAI-compatible /v1/audio/transcriptions server
# (the GPU Companion, speaches, whisper-asr-webservice, whisper.cpp server
# with --inference-path /v1/audio/transcriptions). Only extracted audio is
# uploaded, never source video. Any remote failure mid-job falls back to
# the local Whisper ladder automatically. Blank = fully local (default).
# WHISPER_REMOTE_URL=http://192.168.1.50:11500
# WHISPER_REMOTE_API_KEY=
# Model override for the remote server. Blank = auto ladder. By default
# (WHISPER_REMOTE_PREFER_ACCURACY=true) every job — English/auto included —
# requests full large-v3 for the accuracy win. Set it false to opt into
# speed: English/auto then use large-v3-turbo while pinned non-English
# stays on large-v3. A model you pin in Settings always wins.
# WHISPER_REMOTE_MODEL=
# WHISPER_REMOTE_PREFER_ACCURACY=true

# GPU Companion installer distribution (Settings → GPU Companion card).
# Docker build args (not env): COMPANION_VERSION=latest COMPANION_REPO=jyoung2000/61
# Runtime cache for "Check for Companion updates" (docker-compose mounts
# ./data/companion-cache here):
# CLIPAI_COMPANION_CACHE_DIR=/config/companion-cache
# CLIPAI_COMPANION_REPO=jyoung2000/61

# ── GPU selection ───────────────────────────────────────────────────────
# Pin ClipAI (and its Ollama sidecar) to ONE GPU on a multi-GPU host.
# Run `nvidia-smi -L` to list cards, then set this to that card's index
# (0, 1, ...) or — more stable across reboots — its GPU-<uuid> string.
# Example for a box with a 4070 + a 1650, to use only the 1650:
#   CLIPAI_GPU_ID=GPU-xxxxxxxx-xxxx-xxxx-xxxx-xxxxxxxxxxxx
# Leave blank to use GPU 0.
CLIPAI_GPU_ID=

# Device for the reframer's YOLO-World subject pass: auto | cuda | cpu.
# 'auto' uses the GPU when >=3.5GB VRAM is free (covers a 4GB GTX 1650).
CLIPAI_REFRAMER_YOLO_DEVICE=auto

# ── API key for /api/v1/* ───────────────────────────────────────────────
# Leave blank to have ClipAI auto-generate + persist one on first boot.
CLIPAI_API_KEY=

# ── Cloud storage integration (Google Drive + Box) ──────────────────────
# Feature flag. Set to "false" to kill the entire integration from the
# Unraid template if something goes wrong in production.
CLIPAI_CLOUD_STORAGE_ENABLED=true

# 32 url-safe base64-encoded bytes used to encrypt OAuth tokens at rest.
# Generate one with:
#   python -c "from cryptography.fernet import Fernet; print(Fernet.generate_key().decode())"
# If you leave this blank, an ephemeral key is generated at startup and
# every container restart drops your stored cloud sessions.
CLIPAI_TOKEN_ENC_KEY=

# Google Drive OAuth app (from console.cloud.google.com → APIs & Services).
# Scope used: https://www.googleapis.com/auth/drive.readonly
# See docs/cloud-storage/SETUP.md for the full walkthrough.
GOOGLE_DRIVE_CLIENT_ID=
GOOGLE_DRIVE_CLIENT_SECRET=
GOOGLE_DRIVE_REDIRECT_URI=http://localhost:8000/api/cloud/google_drive/callback

# Box OAuth app (from app.box.com/developers/console).
# Enable "Read all files and folders stored in Box" in the app's
# configuration; leave every write permission off.
BOX_CLIENT_ID=
BOX_CLIENT_SECRET=
BOX_REDIRECT_URI=http://localhost:8000/api/cloud/box/callback

# ── Reframer "human camera operator" upgrades ──────────────────────────
# Each flag toggles one reframing improvement. Pure-code items default ON;
# model-dependent / invasive items default OFF (they need an extra model or
# fall back gracefully). Leave unset to use the defaults in backend/config.py.
#
# Smoothing / motion model (default ON):
#   REFRAMER_ONE_EURO_FILTER=true       # speed-adaptive target smoothing (vs EMA)
#   REFRAMER_SAVGOL_SMOOTHING=true       # offline Savitzky-Golay path pass
#   REFRAMER_SALIENCY_STACK=true         # fused saliency + temporal smoothing (no-face)
#   REFRAMER_LEAD_ROOM=true              # anticipatory lead-room (velocity + gaze)
#   REFRAMER_EYE_LINE_ANCHOR=true        # frame on the eye-line, not the bbox center
#   REFRAMER_OVERLAY_VELOCITY=true       # emit per-box velocity for preview propagation
#
# Model-dependent (default OFF — needs an extra model download):
#   REFRAMER_MEDIAPIPE_MAR=false         # MediaPipe 478-pt lips MAR (needs face_landmarker.task)
#   REFRAMER_MEDIAPIPE_MODEL_PATH=       # path to face_landmarker.task (blank = auto-discover)
#
# Higher-ceiling items (default ON):
#   REFRAMER_U2NET_SALIENCY=true         # u2netp learned saliency; the model is baked into the
#                                        #   image and auto-discovered (spectral fallback if missing)
#   REFRAMER_U2NET_MODEL_PATH=           # explicit path override (blank = auto-discover)
#   REFRAMER_L1_PATH=true                # L1-optimal camera path (holds + linear pans)
#   REFRAMER_L1_WEIGHTS=1,10,100         # w1,w2,w3 for |D1|,|D2|,|D3|
#   REFRAMER_MOTIVATED_ZOOM=true         # slow push-in on held speakers (no-op without a real hold)
#   REFRAMER_MOTIVATED_ZOOM_MAX=1.15     # max push-in scale
#
# Human-operator framing (audit Phase 2, default ON):
#   REFRAMER_L1_DEADBAND_FRAC=0.025      # subject motion under 2.5% of crop width doesn't move the camera
#   REFRAMER_SACCADE_CUT_FRAC=0.38       # displacements over 38% of crop width cut instead of whip-panning
#   REFRAMER_VERTICAL_EYELINE=true       # eye-line at 1/3 from crop top for 16:9/4:3 outputs (vs blind centering)
#   REFRAMER_HEADROOM_MIN_FRAC=0.08      # min face-to-crop-edge margin (fraction of crop height)
#   REFRAMER_EXPORT_KEYPOINT_HZ=10       # min keypoint density for the FFmpeg motion path (kills velocity steps)
#   REFRAMER_TILED_ADAPTIVE=true         # run tiled face detection only when faces are small/missing (faster)
#   REFRAMER_TILED_MIN_FACE_FRAC=0.04    # "small face" threshold — fraction of frame height

# ── Transcription quality (audit Phase 3) ───────────────────────────────
# CTC forced-alignment refinement of Whisper word timestamps (torchaudio
# wav2vec2 or the ctc-forced-aligner package; <1 GB, GPU only when free).
# Cues snap within ~1 frame of speech onset/offset. No-op without a backend.
#   SUBTITLE_FORCED_ALIGN=true
# VAD tuning + faster-whisper's silence-gap hallucination guard:
#   WHISPER_VAD_MIN_SILENCE_MS=300
#   WHISPER_VAD_SPEECH_PAD_MS=150
#   WHISPER_HALLUCINATION_SILENCE_S=2.0
# Two-pass redecode of difficult segments (hallucination-flagged, low
# avg_logprob, or degenerate batched word timing), bounded to 10%:
#   WHISPER_REDECODE_ENABLED=true
#   WHISPER_REDECODE_LOGPROB=-0.8
#   WHISPER_REDECODE_MAX_FRAC=0.10
#   WHISPER_REDECODE_BEAM=8
# Auto-upgrade targets distil-large-v3 instead of large-v3-turbo on
# English-only libraries (distil ≈ large-v3 English WER at ~2x speed):
#   WHISPER_PREFER_DISTIL_ENGLISH=false

# ── Cloud transcription + subtitle polish model (audit Phase 4) ─────────
# Where the primary transcription pass runs. Cloud output flows through
# the SAME post chain (hallucination filter → forced alignment → polish →
# formatter) and falls back to local automatically on API failure.
#   TRANSCRIPTION_PROVIDER=local            # local | groq | openai
#   GROQ_TRANSCRIBE_MODEL=whisper-large-v3-turbo
#   OPENAI_TRANSCRIBE_MODEL=whisper-1       # or gpt-4o-transcribe (words re-timed by forced alignment)
#   OPENAI_API_KEY=
# Dedicated subtitle-polish model (an OpenRouter id — see Settings >
# Subtitle Quality > "Recommended for subtitle polish"). Blank = polish
# runs on the translation model (legacy default).
#   SUBTITLE_POLISH_MODEL=

# ── Container speed (audit Phase 5) ─────────────────────────────────────
# Perception decode: grab() sequentially for gaps up to this many frames;
# only larger jumps hard-seek (each seek re-decodes a whole GOP on
# long-GOP H.264 — the old gap>5 threshold seeked on EVERY sample).
# Benchmark strategies on your content: scripts/bench_perception_decode.py
#   REFRAMER_SEEK_GAP_FRAMES=60
# NVENC speed/quality toggle: p1 (fastest) .. p7 (best quality).
# Adaptive quantization (-spatial_aq/-temporal_aq) is always on for NVENC.
#   GPU_NVENC_PRESET=p5
# Run Demucs vocal separation concurrent with the visual perception pass.
# Auto-degrades to sequential on GPUs under 6 GB total (a 4 GB GTX 1650
# never runs Demucs + YOLO at the same time).
#   VOCAL_SEPARATION_CONCURRENT=true
# Candidate-clip export fast path: remux the bytes (-c copy) instead of
# re-encoding every candidate clip. Bit-identical to the source; preview
# starts snap to the previous keyframe (~1-2 s early). Final user exports
# always re-read the original video, so deliverables are unaffected.
# Default ON. Set false for frame-accurate preview starts (then also
# consider GPU_ACCELERATION_ENABLED=true so the encodes use NVENC).
#   CLIP_EXPORT_STREAM_COPY=true
# How many candidate-clip ffmpeg jobs run at once (re-encode path only;
# 3 concurrent NVENC sessions is safe on every consumer NVIDIA driver).
#   CLIP_EXPORT_CONCURRENCY=3
# Passive keep-alive sent with every Ollama TEXT call so the translation /
# editorial model isn't evicted by Ollama's 5-min default across longer
# stage gaps (30-60 s cold reload each time). Explicit VRAM handoffs
# (keep_alive=0) still win. "-1" pins forever; empty sends nothing.
#   OLLAMA_TEXT_KEEP_ALIVE=30m
# Perception sample budget. A shorter video is sampled at
# min(5.0, REFRAMER_MAX_SAMPLES/duration_s) fps with a floor of
# REFRAMER_MIN_SAMPLE_FPS — so a 24-min video gets the same ~1800-sample
# budget as a 2-hour one. Lowering the floor to 0.8 (or the cap to ~1200)
# is the single biggest local-rig speed knob (~linear in samples) at a
# small, well-precedented reframing-accuracy cost. Defaults unchanged.
#   REFRAMER_MAX_SAMPLES=1800
#   REFRAMER_MIN_SAMPLE_FPS=1.2
# Static-scene skip + u2netp mask stride (the profiled anime run spent 612s
# of the face loop on per-sample work dominated by u2netp CPU forwards on
# hold frames; outputs change only on frames that changed):
#   REFRAMER_STATIC_SKIP=true
#   REFRAMER_U2NET_STRIDE=2
# Cap on map-reduce summary chunks (each is one LLM round-trip).
#   SUMMARY_MAX_CHUNKS=12
# Stage-overlap gates (speed audit). All default ON; every overlap runs the
# same calls with the same inputs, just earlier — small shared local cards
# always keep the proven serial order automatically.
# Translate+polish → summary chain concurrent with clip detection on a
# remote ≥7 GB Ollama host (Companion):
#   PIPELINE_OVERLAP_TRANSLATION_CLIPS=true
# Local CUDA Whisper concurrent with the face loop when ≥6 GB VRAM is free:
#   WHISPER_LOCAL_CONCURRENT_WITH_FACES=true
#   WHISPER_LOCAL_CONCURRENT_MIN_FREE_GB=6.0
# Per-clip Auto-SEO runs after the COMPLETE save instead of blocking it:
#   SEO_AFTER_COMPLETE=true
# Hybrid word-timing reference decodes only split-candidate windows instead
# of a full second Whisper pass over the whole video:
#   HYBRID_WHISPER_REF_WINDOWED=true
# Pre-translation source polish (one extra full-transcript LLM pass on the
# critical path; the translated track does not depend on it — see config.py):
#   TRANSLATION_POLISH_SOURCE_FIRST=false
# Grammar-enforced batch translation output (Ollama structured outputs):
# the decode is constrained to a JSON array of exactly the batch's line
# count, eliminating the parse-miss → split-and-retry cascade (~1/3 of
# batches on a measured gemma3:12b run). Auto-downgrades on old servers.
#   TRANSLATION_STRUCTURED_OUTPUTS=true
# Large-model (12B+) translation may run 2 batches in flight when the
# Companion's VRAM budget minus model weights leaves this much headroom
# (Ollama continuous batching: ~1.5-1.8x throughput, identical outputs).
#   TRANSLATION_LARGE_CONCURRENCY_MAX=2
#   TRANSLATION_LARGE_PARALLEL_HEADROOM_GB=2.0

# ── Language purity + coherence (run-13 follow-up) ──────────────────────
# Wrong-script hallucination gate: with the source language pinned (or
# confidently detected) CJK, a 4+-word all-Latin cue is a decode
# hallucination over music/silence, not speech — quarantined like the
# other TACT filters:
#   WHISPER_SCRIPT_FILTER=true
# Polish the LLM-translated TARGET track too (MTPE with cloud fallback) —
# historically the LLM translation shipped raw, typos and all:
#   TRANSLATION_POLISH_LLM_OUTPUT=true

# ── Reframing: detection density + repair + vertical framing ────────────
# Bridge the gaps between sparse detection samples with LK optical-flow
# tracking on frames the decoder already visited (~zero extra decode):
#   REFRAMER_INTER_SAMPLE_TRACKING=true
#   REFRAMER_TRACK_POINTS_PER_GAP=3
# Problem-driven repair: densely re-detect inside the evaluator's HIGH
# face_missing windows and insert corrective keyframes before the bridge:
#   REFRAMER_PROBLEM_REPAIR=true
#   REFRAMER_REPAIR_MAX_WINDOWS=40
# Per-scene vertical eye-line for sub-full-height crops (1:1, 4:5):
#   REFRAMER_PER_SCENE_EYELINE=true

# ── User-accurate reframe grading ────────────────────────────────────────
# Per-clip grades + a duration-weighted aggregate are computed
# automatically (viewers only watch the exported clips). The report also
# carries p10_window_score (worst 30s stretches) and caps the letter grade
# when HIGH-problem density is high. VLM spot-check: the local vision
# model judges ~12 cropped frames ("is the subject well-framed?") as a
# calibration signal (vlm_framing_pct — never blended into the grade):
#   REFRAME_VLM_SPOTCHECK=true
#   REFRAME_VLM_FRAMES=12

# ── Polish reliability + preview proxy (post-run fixes) ─────────────────
# Cloud safety net for subtitle polishing: when the local chain fails a
# batch (Ollama cold-load timeout / circuit breaker / offline-only chain),
# the batch retries via OpenRouter — only when an OpenRouter key exists.
#   SUBTITLE_POLISH_CLOUD_FALLBACK=true
#   SUBTITLE_POLISH_CLOUD_MODEL=            # blank = shortlist top efficient pick
# Auto-derived proper-noun glossary so names render consistently
# (Zechs, not Zeks/Zecks/Zeck):
#   SUBTITLE_POLISH_AUTO_GLOSSARY=true
# Romaji passthrough detection now also applies to auto-detected sources
# (stricter threshold) — existing flags:
#   TRANSLATION_ROMAJI_DETECT_ENABLED=true
#   TRANSLATION_ROMAJI_DETECT_THRESHOLD=0.6
