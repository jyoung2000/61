{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "ClipAI GPU Companion",
  "version": "0.10.0",
  "identifier": "app.clipai.companion",
  "build": {
    "beforeDevCommand": "npm run dev",
    "devUrl": "http://localhost:14420",
    "beforeBuildCommand": "npm run build",
    "frontendDist": "../dist"
  },
  "app": {
    "windows": [
      {
        "title": "ClipAI GPU Companion",
        "label": "main",
        "width": 860,
        "height": 640,
        "minWidth": 640,
        "minHeight": 480,
        "resizable": true,
        "center": true,
        "visible": true
      }
    ],
    "security": {
      "csp": "default-src 'self'; connect-src 'self' ipc: http://ipc.localhost; style-src 'self' 'unsafe-inline'; img-src 'self' data:"
    },
    "trayIcon": {
      "id": "main-tray",
      "iconPath": "icons/icon.png",
      "iconAsTemplate": true,
      "tooltip": "ClipAI GPU Companion"
    }
  },
  "bundle": {
    "active": true,
    "targets": [
      "nsis",
      "msi",
      "dmg"
    ],
    "category": "Utility",
    "shortDescription": "Share your desktop GPU with ClipAI",
    "longDescription": "Runs Ollama and a Whisper transcription sidecar behind one authenticated LAN port so a ClipAI server (e.g. on Unraid) can borrow this machine's GPU for AI analysis.",
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ],
    "resources": [
      "sidecar"
    ],
    "windows": {
      "webviewInstallMode": {
        "type": "offlineInstaller"
      },
      "nsis": {
        "installMode": "currentUser",
        "installerHooks": "./windows/hooks.nsh",
        "languages": [
          "English"
        ],
        "displayLanguageSelector": false
      }
    },
    "macOS": {
      "minimumSystemVersion": "12.0"
    }
  },
  "plugins": {}
}
